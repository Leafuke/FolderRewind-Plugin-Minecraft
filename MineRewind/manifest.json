{
  "manifestVersion": 3,
  "pluginId": "com.folderrewind.minerewind",
  "name": "MineRewind",
  "localizedName": {
    "en-US": "MineRewind",
    "zh-CN": "MineRewind"
  },
  "version": "1.9.0",
  "author": "Leafuke",
  "description": "Enhanced Minecraft saves backup with discovery, consistency coordination, hot restore coordination, and commands.",
  "localizedDescription": {
    "en-US": "Enhanced Minecraft saves backup with discovery, consistency coordination, hot restore coordination, and commands.",
    "zh-CN": "Minecraft 存档备份增强插件：提供发现、一致性协调、热还原协调和命令能力。"
  },
  "pluginApi": {
    "major": 3,
    "minor": 0
  },
  "entryAssembly": "MineRewind.dll",
  "entryType": "MineRewind.MinecraftSavesPlugin",
  "configKinds": [
    {
      "ownerId": "com.folderrewind.minerewind",
      "kindId": "minecraft-saves",
      "displayName": "Minecraft Saves",
      "backupFallback": "rawWithWarnings",
      "restoreCoordination": "required"
    }
  ],
  "settingsSchema": "settings.schema.json",
  "requestedHostServices": [
    "backupRequest",
    "restoreRequest",
    "knotLink",
    "logging"
  ],
  "capabilities": [
    "discovery",
    "backupConsistency",
    "restoreCoordinator",
    "pluginCommand",
    "providerStateMigration"
  ],
  "homepage": "https://github.com/Leafuke/FolderRewind-Plugin-Minecraft",
  "repository": "Leafuke/FolderRewind-Plugin-Minecraft"
}
