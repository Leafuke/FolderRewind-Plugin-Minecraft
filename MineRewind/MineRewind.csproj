<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;AnyCPU</Platforms>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.9.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FolderRewind.Plugin.Abstractions" Version="3.1.0">
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="fNbt" Version="1.0.0" />
  </ItemGroup>
  <Target Name="PackFrPlugin" DependsOnTargets="Build">
    <PropertyGroup>
      <FrPluginOutput Condition="'$(FrPluginOutput)'==''">$(MSBuildProjectDirectory)\..\artifacts\MineRewind-$(Version).frplugin</FrPluginOutput>
      <PluginPackAppData>$(MSBuildProjectDirectory)\..\artifacts\.pack-appdata</PluginPackAppData>
    </PropertyGroup>
    <MakeDir Directories="$(PluginPackAppData)" />
    <Exec EnvironmentVariables="APPDATA=$(PluginPackAppData)" Command="dotnet restore &quot;$(MSBuildProjectDirectory)\..\tools\MineRewind.Pack\MineRewind.Pack.csproj&quot; --configfile &quot;$(MSBuildProjectDirectory)\..\NuGet.Config&quot;" />
    <Exec EnvironmentVariables="APPDATA=$(PluginPackAppData)" Command="dotnet run --no-restore --project &quot;$(MSBuildProjectDirectory)\..\tools\MineRewind.Pack\MineRewind.Pack.csproj&quot; -- &quot;$(TargetDir).&quot; &quot;$(FrPluginOutput)&quot;" />
  </Target>
  <ItemGroup>
    <Compile Include="V3\**\*.cs" />
    <Compile Include="NbtHelper.cs" />
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="settings.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
