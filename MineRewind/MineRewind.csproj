<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.10.2</Version>
    <PluginApiPackageVersion Condition="'$(PluginApiPackageVersion)'==''">3.18.0</PluginApiPackageVersion>
    <ContractProvenance Condition="'$(ContractProvenance)'==''">$(MSBuildProjectDirectory)\..\contracts\source-manifest.json</ContractProvenance>
    <AllowDevelopmentContract Condition="'$(AllowDevelopmentContract)'==''">false</AllowDevelopmentContract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MineRewind.World\MineRewind.World.csproj" />
    <PackageReference Include="FolderRewind.Plugin.Abstractions" Version="[$(PluginApiPackageVersion)]">
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="fNbt" Version="1.0.0" />
  </ItemGroup>
  <Target Name="VerifyResolvedContract" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences" Condition="'$(DesignTimeBuild)'!='true'">
    <ItemGroup><_ContractReference Include="@(ReferencePath->WithMetadataValue('Filename', 'FolderRewind.Plugin.Abstractions'))" /></ItemGroup>
    <Error Condition="'@(_ContractReference)'==''" Text="Resolved SDK ReferencePath is missing." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\tools\Verify-Contract.ps1&quot; -ReferencePath &quot;@(_ContractReference->'%(FullPath)')&quot; -EffectiveVersion &quot;$(Version)&quot; -EffectiveSdkVersion &quot;$(PluginApiPackageVersion)&quot; -Provenance &quot;$(ContractProvenance)&quot; -AllowDevelopmentContract &quot;$(AllowDevelopmentContract)&quot; -PackagePathOutput &quot;$(IntermediateOutputPath)contract-package.path&quot;" />
    <ReadLinesFromFile File="$(IntermediateOutputPath)contract-package.path"><Output TaskParameter="Lines" PropertyName="_ContractPackagePath" /></ReadLinesFromFile>
  </Target>
  <Target Name="PackFrPlugin" DependsOnTargets="Build;VerifyResolvedContract">
    <PropertyGroup>
      <FrPluginOutput Condition="'$(FrPluginOutput)'==''">$(MSBuildProjectDirectory)\..\artifacts\MineRewind-$(Version).frplugin</FrPluginOutput>
      <PluginPackStaging>$(MSBuildProjectDirectory)\..\artifacts\pack-staging\$([System.Guid]::NewGuid().ToString('N'))</PluginPackStaging>
      <PluginPackAppData>$(MSBuildProjectDirectory)\..\artifacts\.pack-appdata</PluginPackAppData>
    </PropertyGroup>
    <ItemGroup>
      <PluginPayload Include="$(TargetDir)MineRewind.dll;$(TargetDir)MineRewind.World.dll;$(TargetDir)fNbt.dll;$(TargetDir)K4os.Compression.LZ4.dll;$(TargetDir)System.IO.Hashing.dll;$(TargetDir)preview-dependencies.NOTICE.txt;$(TargetDir)manifest.json;$(TargetDir)settings.schema.json" />
    </ItemGroup>
    <MakeDir Directories="$(PluginPackAppData);$(PluginPackStaging)" />
    <Copy SourceFiles="@(PluginPayload)" DestinationFolder="$(PluginPackStaging)" />
    <Copy SourceFiles="$(ContractProvenance)" DestinationFiles="$(PluginPackStaging)\contract-source.json" />
    <Exec EnvironmentVariables="APPDATA=$(PluginPackAppData)" Command="dotnet restore &quot;$(MSBuildProjectDirectory)\..\tools\MineRewind.Pack\MineRewind.Pack.csproj&quot; --configfile &quot;$(MSBuildProjectDirectory)\..\NuGet.Config&quot;" />
    <Exec EnvironmentVariables="APPDATA=$(PluginPackAppData)" Command="dotnet run --no-restore -c $(Configuration) --project &quot;$(MSBuildProjectDirectory)\..\tools\MineRewind.Pack\MineRewind.Pack.csproj&quot; -- &quot;$(PluginPackStaging)&quot; &quot;$(FrPluginOutput)&quot; --sdk &quot;@(_ContractReference->'%(FullPath)')&quot; --sdk-package &quot;$(_ContractPackagePath)&quot; --allow-development &quot;$(AllowDevelopmentContract)&quot;" />
    <RemoveDir Directories="$(PluginPackStaging)" />
  </Target>
  <ItemGroup>
    <Compile Include="V3\**\*.cs" />
    <Compile Include="NbtHelper.cs" />
    <None Include="preview-dependencies.NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="settings.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
